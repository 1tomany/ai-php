#!/usr/bin/env php
<?php

use OneToMany\AI\Command\UploadFileCommand;
use Symfony\Component\Console\Application;

require dirname(__DIR__).'/vendor/autoload.php';

$application = new Application('php-ai Examples');

$uploadFile = new UploadFileCommand();

$application->addCommands([
    $uploadFile,
]);

exit($application->run());
// exit(ApplicationFactory::create(dirname(__DIR__))->run());
